<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/da_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_android_auto" android:importantForAccessibility="no"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/da_brand" android:textSize="26sp" android:textColor="@color/da_text" android:fontFamily="sans-serif-medium"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/exit_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="56dp" android:text="Araç Ana Ekranı" android:textColor="@color/da_muted"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TELEFONUNUZ. SÜRÜŞÜNÜZ." android:textSize="12sp" android:textColor="@color/da_accent" android:letterSpacing="0.16"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tanıdık bir sürüş." android:textSize="42sp" android:textColor="@color/da_text" android:fontFamily="sans-serif-medium" android:layout_marginTop="14dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Haritalarınız, müziğiniz ve görüşmeleriniz.&#10;Android Auto, doğrudan aracınızın ekranında." android:textSize="19sp" android:textColor="@color/da_muted" android:lineSpacingExtra="6dp" android:layout_marginTop="16dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:orientation="vertical" android:padding="24dp" android:background="@drawable/da_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KABLOSUZ ANDROID AUTO" android:textSize="12sp" android:textColor="@color/da_accent" android:letterSpacing="0.1"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hazır olduğunuzda bekliyor" android:textSize="24sp" android:textColor="@color/da_text" android:id="@+id/connection_status" android:accessibilityLiveRegion="polite" android:layout_marginTop="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/wifi_button" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="12dp" android:text="Telefonu bağla" android:textSize="18sp" android:textAllCaps="false" android:gravity="center" android:textColor="@color/da_background" app:backgroundTint="@color/da_accent" app:cornerRadius="20dp" app:icon="@drawable/ic_android_auto" app:iconTint="@color/da_background" app:iconGravity="textStart" app:iconPadding="12dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Telefonunuzu aracın Bluetooth ayarlarından eşleştirin, ardından Telefonu bağla'yı seçin. Bluetooth ve Wi-Fi açık olsun." android:textSize="15sp" android:textColor="@color/da_muted" android:layout_marginTop="12dp" android:lineSpacingExtra="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/quick_device_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/da_card"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_quick_device_icon"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:id="@+id/quick_device_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_android_auto"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/quick_device_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_quick_bt_title"
                        android:textSize="11sp"
                        android:textColor="@color/da_accent"
                        android:letterSpacing="0.1"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:id="@+id/quick_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_device"
                        android:textSize="18sp"
                        android:textColor="@color/da_text"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:ellipsize="end"/>
                    <TextView
                        android:id="@+id/quick_device_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/da_quick_bt_hint"
                        android:textSize="13sp"
                        android:textColor="@color/da_muted"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quick_connect_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="@string/da_quick_btn_connect"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@color/da_background"
                    app:backgroundTint="@color/da_accent"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_android_auto"
                    app:iconTint="@color/da_background"
                    app:iconPadding="6dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/other_devices_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone"/>
            <ImageView android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="20dp" android:src="@drawable/ic_android_auto" android:importantForAccessibility="no"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/usb_button" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="12dp" android:text="USB ile Bağlan" android:textSize="18sp" android:textAllCaps="false" android:gravity="center" android:textColor="@color/da_text" app:backgroundTint="@color/da_surface" app:cornerRadius="20dp" app:icon="@drawable/ic_usb_white" app:iconTint="@color/da_accent" app:iconGravity="textStart" app:iconPadding="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kabloyu mu tercih edersiniz? Telefonunuzu takın." android:textSize="14sp" android:textColor="@color/da_muted" android:gravity="center" android:layout_marginTop="6dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/settings_button" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="12dp" android:text="Ayarlar" android:textSize="18sp" android:textAllCaps="false" android:gravity="center" android:textColor="@color/da_text" app:backgroundTint="@color/da_surface" app:cornerRadius="20dp" app:icon="@drawable/ic_settings_white" app:iconTint="@color/da_accent" app:iconGravity="textStart" app:iconPadding="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kendinizi evinizde hissedin." android:textSize="14sp" android:textColor="@color/da_muted" android:gravity="center" android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
